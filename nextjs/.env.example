# Display name used in the header, sidebar, auth pages, and page metadata.
NEXT_PUBLIC_APP_NAME=

# IANA business timezone for persisted display strings; mirror the server's
# APP_TIMEZONE. Default: UTC
NEXT_PUBLIC_APP_TIMEZONE=

# FastAPI origin, e.g. https://api.example.com — required. This is a static
# export (output: "export") with no server or reverse proxy of its own, so
# every request goes straight from the browser to this origin; there is no
# same-origin relative fallback in production.
NEXT_PUBLIC_SERVER_URL=
NEXT_PUBLIC_API_VERSION=

# Public URL of this client (used for absolute links)
NEXT_PUBLIC_DOMAIN_URL=

# The browser talks to the API directly (see NEXT_PUBLIC_SERVER_URL above) —
# sign-in, renewal and sign-out all hit it, and it owns the session cookie
# (SameSite=None; Secure in production) and hands back the access token in
# the response body, kept client-side in memory. So there is no pool id,
# client id, or cookie flag to publish here.
